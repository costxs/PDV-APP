{
  "expo": {
    "name": "pdv-app",
    "slug": "pdv-app",
    "version": "1.3",
    "orientation": "portrait",
    "icon": "./assets/images/savora-logo-square.png",
    "scheme": "pdvapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/savora-logo-square.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dgcostxs.pdvapp"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/savora-logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/savora-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "5ffd59b5-6525-4f2d-a296-8c3ed09330de"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5ffd59b5-6525-4f2d-a296-8c3ed09330de"
    }
  }
}
